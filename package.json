  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "ARCHITECTURE.md",
    "SECURITY.md",
    "REGISTRY.md",
    "ADOPTION.md",
    "capability-manifest.schema.json",
    "CHANGELOG.md",
