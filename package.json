  "name": "@wheresmycoleslaw/capability",
  "version": "0.9.0",
  "description": "A software-metabolism runtime for agents to discover, mine, bind, compose, isolate, and acquire abilities from existing software across multiple execution substrates.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
