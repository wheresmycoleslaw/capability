          "output": {
            "type": "object",
            "properties": {
              "uniquenessScore": {
                "type": "number"
              },
              "classification": {
                "type": "string"
              },
              "nearest": {
                "type": "array"
              },
              "recommendation": {
                "type": "string"
              }
