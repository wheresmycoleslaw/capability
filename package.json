              "reproducible": {
                "type": "boolean"
              },
              "changes": {
                "type": "array"
              },
              "score": {
                "type": "number"
              }
            },
            "required": [
              "severity",
              "reproducible",
              "changes",
              "score"
            ]
          },
          "effects": [],
          "behavior": {
            "deterministic": true,
            "idempotent": true,
            "reversible": false
          },
          "tags": [
            "capability",
            "receipts",
            "drift",
            "reproducibility",
            "supply-chain"
          ]
