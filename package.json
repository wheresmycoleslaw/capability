          "output": {
            "type": "object",
            "properties": {
              "effects": {
                "type": "array"
              },
              "openWorldEffects": {
                "type": "array"
              },
              "overDeclaredEffects": {
                "type": "array"
              },
              "perCapabilityOverDeclaration": {
