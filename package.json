          "effects": [],
          "behavior": {
            "deterministic": true,
            "idempotent": true,
            "reversible": false
          },
          "tags": [
            "capability",
            "innovation",
            "novelty",
            "duplicate-detection",
            "ecosystem-design"
          ]
